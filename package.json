{
  "name": "devguard-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r run build",
    "gen:schema": "pnpm --filter @devguard/core run gen:schema",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -b",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "devguard": "node packages/cli/dist/index.js"
  },
  "devDependencies": {
    "@devguard/cli": "workspace:*",
    "@eslint/js": "^9.20.0",
    "@types/node": "^26.6.3",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.0.1",
    "prettier": "^3.5.1",
    "tsup": "^8.3.6",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
