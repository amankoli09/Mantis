{
  "name": "mantis-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter '@mantis/*' run build && pnpm --filter mantis-frontend build",
    "build:frontend": "pnpm --filter mantis-frontend build",
    "build:packages": "pnpm --filter '@mantis/*' run build",
    "gen:schema": "pnpm --filter @mantis/core run gen:schema",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -b",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "mantis": "node packages/cli/dist/index.js",
    "check:branding": "node scripts/check-branding.js",
    "check:secrets": "node scripts/check-secret-leak.js",
    "docs:check": "node scripts/check-docs.js",
    "benchmark": "tsx scripts/run-benchmarks.ts"
  },
  "devDependencies": {
    "@mantis/cli": "workspace:*",
    "@eslint/js": "^9.20.0",
    "@types/node": "^26.6.3",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.0.1",
    "prettier": "^3.5.1",
    "tsup": "^8.3.6",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
