{
  "name": "@mantis/cli",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "mantis": "./dist/index.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "mantis": "node ./dist/index.js"
  },
  "dependencies": {
    "@mantis/adapter-express": "workspace:*",
    "@mantis/core": "workspace:*",
    "@mantis/runner": "workspace:*",
    "commander": "^13.1.0",
    "picocolors": "^1.1.1"
  }
}
